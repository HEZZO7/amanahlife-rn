[{"number":1,"text":"﻿بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ","numberInSurah":1},{"number":2,"text":"ٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَٰلَمِينَ","numberInSurah":2},{"number":3,"text":"ٱلرَّحْمَٰنِ ٱلرَّحِيمِ","numberInSurah":3},{"number":4,"text":"مَٰلِكِ يَوْمِ ٱلدِّينِ","numberInSurah":4},{"number":5,"text":"إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ","numberInSurah":5},{"number":6,"text":"ٱهْدِنَا ٱلصِّرَٰطَ ٱلْمُسْتَقِيمَ","numberInSurah":6},{"number":7,"text":"صِرَٰطَ ٱلَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ ٱلْمَغْضُوبِ عَلَيْهِمْ وَلَا ٱلضَّآلِّينَ","numberInSurah":7}]